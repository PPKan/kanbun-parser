<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="note" version="1.0" page-range-format="expanded" default-locale="ja-JP">
  <info>
    <title>Word-like Japanese Note</title>
    <id>https://example.com/styles/word-japanese-note</id>
    <link href="https://example.com/styles/word-japanese-note" rel="self"/>
    <author>
      <name>OpenAI Codex</name>
    </author>
    <category citation-format="note"/>
    <updated>2026-03-12T00:00:00+00:00</updated>
  </info>
  <locale xml:lang="ja-JP">
    <terms>
      <term name="page">頁</term>
      <term name="page-range-delimiter">-</term>
    </terms>
  </locale>
  <macro name="contributors">
    <names variable="author">
      <name delimiter=", " initialize-with=""/>
      <substitute>
        <names variable="editor" suffix="（校注）">
          <name delimiter=", " initialize-with=""/>
        </names>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>
  <macro name="title">
    <choose>
      <if type="book collection" match="any">
        <text variable="title" prefix="『" suffix="』"/>
      </if>
      <else>
        <text variable="title" prefix="「" suffix="」"/>
      </else>
    </choose>
  </macro>
  <macro name="website">
    <choose>
      <if variable="container-title">
        <text variable="container-title"/>
      </if>
      <else-if variable="source">
        <text variable="source"/>
      </else-if>
      <else-if variable="publisher">
        <text variable="publisher"/>
      </else-if>
    </choose>
  </macro>
  <macro name="year">
    <choose>
      <if variable="issued">
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </if>
      <else-if variable="accessed">
        <date variable="accessed">
          <date-part name="year"/>
        </date>
      </else-if>
    </choose>
  </macro>
  <macro name="publication">
    <choose>
      <if type="webpage">
        <group prefix="（" suffix="）" delimiter="、">
          <text macro="website"/>
          <text macro="year"/>
        </group>
      </if>
      <else-if variable="publisher issued">
        <group prefix="（" suffix="）" delimiter="、">
          <text variable="publisher"/>
          <date variable="issued">
            <date-part name="year"/>
            <date-part name="month" prefix="." form="numeric-leading-zeros"/>
          </date>
        </group>
      </else-if>
      <else-if variable="publisher">
        <text variable="publisher" prefix="（" suffix="）"/>
      </else-if>
    </choose>
  </macro>
  <macro name="locator">
    <choose>
      <if variable="locator">
        <text variable="locator" suffix="頁"/>
      </if>
    </choose>
  </macro>
  <citation>
    <layout delimiter="；">
      <choose>
        <if type="webpage">
          <group delimiter="">
            <text macro="title"/>
            <text macro="publication"/>
            <text value="。"/>
          </group>
        </if>
        <else>
          <group delimiter="">
            <text macro="contributors"/>
            <text macro="title"/>
            <text macro="publication"/>
            <text macro="locator"/>
            <text value="。"/>
          </group>
        </else>
      </choose>
    </layout>
  </citation>
  <bibliography>
    <layout>
      <choose>
        <if type="webpage">
          <group delimiter="">
            <text macro="title"/>
            <text macro="publication"/>
            <text value="。"/>
          </group>
        </if>
        <else>
          <group delimiter="">
            <text macro="contributors"/>
            <text macro="title"/>
            <text macro="publication"/>
            <text value="。"/>
          </group>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
